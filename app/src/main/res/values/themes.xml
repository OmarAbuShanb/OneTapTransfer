<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Base.Theme.OneTapTransfer" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/primary</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorSecondary">@color/secondary</item>
        <item name="colorOnSecondary">@color/white</item>
        <item name="colorControlActivated">@color/secondary</item>
        <item name="android:colorAccent">@color/secondary</item>
        <item name="colorSurface">@color/surface</item>
        <item name="colorOnSurface">@color/text_main</item>
        <item name="android:colorBackground">@color/background</item>
        <item name="colorOnBackground">@color/text_main</item>
        <item name="android:windowBackground">@color/background</item>
        <item name="android:statusBarColor">@color/surface</item>
        <item name="android:navigationBarColor">@color/surface</item>
        <item name="materialAlertDialogTheme">@style/ThemeOverlay.OneTapTransfer.MaterialAlertDialog</item>
        <item name="android:windowLightStatusBar" tools:targetApi="m">true</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="o_mr1">true</item>
    </style>

    <style name="Theme.OneTapTransfer" parent="Base.Theme.OneTapTransfer" />

    <style name="Theme.OneTapTransfer.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenAnimatedIcon">@drawable/app_icon</item>
        <item name="windowSplashScreenBackground">@color/surface</item>
        <item name="postSplashScreenTheme">@style/Theme.OneTapTransfer</item>
    </style>

    <style name="ThemeOverlay.OneTapTransfer.ToolbarPopup" parent="ThemeOverlay.Material3.Light">
        <item name="android:popupBackground">@color/toolbar_popup_bg</item>
        <item name="android:textColorPrimary">@color/toolbar_popup_text</item>
        <item name="android:textColorSecondary">@color/toolbar_popup_text</item>
        <item name="colorOnSurface">@color/toolbar_popup_text</item>
        <item name="colorSurface">@color/toolbar_popup_bg</item>
    </style>

    <style name="ThemeOverlay.OneTapTransfer.MaterialAlertDialog" parent="ThemeOverlay.Material3.MaterialAlertDialog">
        <item name="colorPrimary">@color/secondary</item>
        <item name="colorSurface">@color/surface</item>
        <item name="colorOnSurface">@color/text_main</item>
        <item name="android:textColorPrimary">@color/text_main</item>
        <item name="android:textColorSecondary">@color/text_sub</item>
    </style>

    <style name="AnimationOneTapTransferDialogSlideFromRight">
        <item name="android:windowEnterAnimation">@anim/dialog_slide_in_right</item>
        <item name="android:windowExitAnimation">@anim/dialog_slide_out_right</item>
    </style>

    <style name="TabTextAppearance" parent="TextAppearance.Material3.BodyMedium">
        <item name="android:textSize">12sp</item>
    </style>

    <style name="Widget.OneTapTransfer.TextInputLayout" parent="Widget.MaterialComponents.TextInputLayout.OutlinedBox">
        <item name="boxBackgroundColor">@color/input_card_bg</item>
        <item name="boxStrokeColor">@color/text_input_box_stroke</item>
        <item name="boxStrokeWidth">1dp</item>
        <item name="boxStrokeWidthFocused">2dp</item>
        <item name="hintTextColor">@color/text_input_hint</item>
        <item name="android:textColorHint">@color/text_input_hint</item>
        <item name="errorTextColor">@color/error</item>
    </style>

</resources>
